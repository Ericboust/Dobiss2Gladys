{
  "manifest_version": 1,
  "type": "device",
  "name": "Dobiss2Gladys",
  "description": {
    "en": "Control your Dobiss home automation system from Gladys Assistant.",
    "fr": "Contrôlez votre système domotique Dobiss depuis Gladys Assistant."
  },
  "version": "1.0.3",
  "docker_image": "ghcr.io/ericboust/dobiss2gladys:1.0.3",
  "gladys_version": ">=4.86.0",
  "cover_image": "https://raw.githubusercontent.com/ericboust/dobiss2gladys/main/cover.jpg",
  "categories": [
    "lighting"
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer"
      },
      "description": {
        "en": "Enter the IP address and port of your Dobiss MAX200 controller on your local network.",
        "fr": "Renseignez l'adresse IP et le port de votre contrôleur Dobiss MAX200 sur votre réseau local."
      }
    },
    {
      "key": "host",
      "type": "string",
      "label": {
        "en": "Dobiss MAX200 IP address",
        "fr": "Adresse IP du Dobiss MAX200"
      },
      "placeholder": {
        "en": "192.168.1.50",
        "fr": "192.168.1.50"
      },
      "required": true
    },
    {
      "key": "port",
      "type": "number",
      "label": {
        "en": "Port",
        "fr": "Port"
      },
      "default": 10001,
      "required": true
    }
  ]
}
